# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
MemoryCaptures/
Recordings/

# Never commit your Cesium ion token
Assets/StreamingAssets/cesium-token.txt

# Steam. steam_appid.txt is a local development aid — it must not reach a
# depot, and it must not reach the repo either once it holds a real app id.
# The build_output folders are steamcmd's own logs and chunk cache.
steam_appid.txt
steam/build_output/
steam/content/
steam/steamcmd/
steam/*.local.vdf

# Visual Studio / Rider
.vs/
.idea/
*.csproj
*.sln
*.user
*.pidb
*.booproj
*.svd
*.userprefs

# OS
.DS_Store
Thumbs.db

# Crash reports
sysinfo.txt
*.stackdump

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Android signing. A keystore is the same class of secret as the ion token
# (CLAUDE.md golden rule 1) and losing it means the app can never be updated on
# Play again - keep it backed up somewhere that is not this repository.
# docs/40-ANDROID.md section 4c.
*.keystore
*.jks
keys/

# Unity Asset Manager drops this at the repo root
uam/
